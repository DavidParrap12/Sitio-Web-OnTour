# Copiar a .env.local y al entorno del hosting. No subir claves al repositorio.
# Sin Supabase, la web usa el catálogo inicial; el administrador permanece desactivado.
# Crear proyecto y aplicar schema.sql + TODAS las migraciones, en orden.
# Mantener false hasta completar migraciones, administrador y validación.
NEXT_PUBLIC_SUPABASE_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=circuit-media
# Solo servidor: recepción de solicitudes y límite distribuido. NUNCA NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: endpoint de correo como notificación/fallback.
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
# Analítica desactivada si falta. Solo carga después del consentimiento.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
